{
  "name": "@gold-ops/sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types and API contracts for Gold Ops Console",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.13.5",
    "typescript": "~5.8.3"
  }
}
