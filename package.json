{
  "name": "gold-ops-console",
  "version": "0.0.0",
  "private": true,
  "description": "Schema-driven internal control plane (monorepo)",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22.16.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && node -e \"require('node:fs').rmSync('.turbo',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@eslint/js": "^9.21.0",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.15.0",
    "prettier": "^3.8.1",
    "turbo": "^2.4.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.24.1"
  }
}
